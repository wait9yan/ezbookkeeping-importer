# 复制为 .env；该文件由 uv --env-file 或 Docker Compose 注入进程环境。
# 应用不会自行查找或加载 .env。已存在的进程环境变量优先。
# 空白必需项请填写；不要把连接参数再写入 data/config.toml。

# Docker Compose 镜像；留空采用 compose.yaml 的 latest（仅正式版本发布时更新），可填写完整镜像引用或 digest。
# 仅由部署层读取；compose.build.yaml 显式使用本地构建镜像。
EBKI_IMAGE=

# PostgreSQL
# postgresql://importer:YOUR_PASSWORD@127.0.0.1:5432/ezbookkeeping_importer
EBKI_DATABASE_URL=

# ezBookkeeping
EBKI_LEDGER_URL=http://127.0.0.1:8080
EBKI_LEDGER_TOKEN=

# OpenAI 兼容模型：地址通常以 /v1 结尾；AI 模式 worker/doctor 需三项齐全。
# data/config.toml 中明确选择 classification_mode="rules_only" 时不需要这三项。
EBKI_AI_URL=
EBKI_AI_MODEL=
EBKI_AI_TOKEN=

# IMAP
EBKI_IMAP_HOST=imap.qq.com
EBKI_IMAP_PORT=993
EBKI_IMAP_USERNAME=
EBKI_IMAP_PASSWORD=
