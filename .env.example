# 复制为 .env；该文件由 uv --env-file 或 Docker Compose 注入进程环境。
# 应用不会自行查找或加载 .env。已存在的进程环境变量优先。
# 空白必需项请填写；不要把连接参数再写入 config.toml。

# PostgreSQL：独立 importer 数据库。迁移、状态查询等也需要此项。
# migrate 可自动创建缺失库：必须明确库名，同一账号需有 CREATEDB 权限。
# 例：postgresql://importer:YOUR_PASSWORD@127.0.0.1:5432/ezbookkeeping_importer
EBKI_DATABASE_URL=

# ezBookkeeping：站点根 URL，可含部署子路径，不要追加 /api/v1。
EBKI_LEDGER_URL=http://127.0.0.1:8080
EBKI_LEDGER_TOKEN=
EBKI_LEDGER_TIMEOUT_SECONDS=30

# OpenAI 兼容模型：地址通常以 /v1 结尾；AI 模式 worker/doctor 需三项齐全。
# config.toml 中明确选择 classification_mode="rules_only" 时不需要这三项。
EBKI_AI_URL=
EBKI_AI_MODEL=
EBKI_AI_TOKEN=
EBKI_AI_TIMEOUT_SECONDS=30

# QQ IMAP：使用授权码，不是 QQ 登录密码。
EBKI_IMAP_HOST=imap.qq.com
EBKI_IMAP_PORT=993
EBKI_IMAP_USERNAME=
EBKI_IMAP_PASSWORD=
EBKI_IMAP_TIMEOUT_SECONDS=30

# 运行目录：未设置时本地为 var/evidence、var/reports、var/logs。
# Compose 默认将 ./var/* 挂载到 /app/var/*。
# 若覆盖目录，Compose 要求绝对路径，并将宿主机同一路径挂载到容器。
# EBKI_EVIDENCE_DIR=/absolute/path/to/var/evidence
# EBKI_REPORT_DIR=/absolute/path/to/var/reports
# EBKI_LOG_DIR=/absolute/path/to/var/logs
EBKI_LOG_MAX_BYTES=10485760
EBKI_LOG_BACKUPS=5

# 以下只供 Docker Compose 使用，本地 uv 启动不读取这些项。
# 部署时服务地址应改成该网络内可访问的名称，不能沿用容器内的 127.0.0.1。
EBKI_DOCKER_NETWORK=bookkeeping
# 挂载目录属主需要与容器用户一致；README 展示如何使用当前用户 UID/GID。
# EBKI_UID=10001
# EBKI_GID=10001
